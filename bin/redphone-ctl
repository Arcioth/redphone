#!/usr/bin/env bash
# CLI wrapper for redphone daemon (used by daetron rules and Waybar clicks)
set -euo pipefail

API="http://127.0.0.1:47621"
CMD="${1:-status}"
ARG="${2:-}"

ensure_daemon() {
  if curl -fsS --max-time 0.4 "$API/api/state" >/dev/null 2>&1; then
    return 0
  fi
  systemctl --user start redphone-daemon.service >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do
    curl -fsS --max-time 0.4 "$API/api/state" >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  return 1
}

post() {
  local path="$1" body="$2"
  ensure_daemon || exit 1
  curl -fsS --max-time 2 -X POST -H "Content-Type: application/json" -d "$body" "$API$path" >/dev/null
}

case "$CMD" in
  plug)           post "/api/action" '{"action":"plug"}' ;;
  unplug)         post "/api/action" '{"action":"unplug"}' ;;
  toggle-mode)    post "/api/mode" '{"mode":"toggle"}' ;;
  mode-call)      post "/api/mode" '{"mode":"call"}' ;;
  mode-receive)   post "/api/mode" '{"mode":"receive"}' ;;
  cycle-provider) post "/api/provider" '{"provider":"cycle"}' ;;
  set-provider)   post "/api/provider" "{\"provider\":\"${ARG:-local}\"}" ;;
  set-delay)      post "/api/delay" "{\"delay\":\"${ARG:-random}\"}" ;;
  set-lang)       post "/api/lang" "{\"lang\":\"${ARG:-tr}\"}" ;;
  hide-voice)     post "/api/hide_voice" '{"hide":true}' ;;
  show-voice)     post "/api/hide_voice" '{"hide":false}' ;;
  toggle-hide)    post "/api/hide_voice" '{"hide":"toggle"}' ;;
  dial)           post "/api/action" '{"action":"dial"}' ;;
  answer)         post "/api/action" '{"action":"answer"}' ;;
  hangup)         post "/api/action" '{"action":"hangup"}' ;;
  decline)        post "/api/action" '{"action":"decline"}' ;;
  test-ring)      post "/api/action" '{"action":"test_ring"}' ;;
  record-clone)   post "/api/action" '{"action":"record_clone"}' ;;
  reset-clone)    post "/api/action" '{"action":"reset_clone"}' ;;
  open-ui)        post "/api/action" '{"action":"open_ui"}' ;;
  focus-voice)    post "/api/action" '{"action":"focus_voice"}' ;;
  status)
    ensure_daemon || exit 1
    curl -fsS --max-time 1 "$API/api/state"
    echo
    ;;
  *)
    echo "usage: redphone-ctl plug|unplug|toggle-mode|mode-call|mode-receive|cycle-provider|set-provider <id>|set-delay <random|sec>|dial|answer|hangup|test-ring|record-clone|reset-clone|open-ui|focus-voice|status" >&2
    exit 2
    ;;
esac
