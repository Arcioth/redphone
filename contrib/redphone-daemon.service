[Unit]
Description=Red Phone USB-C handset & browser voice daemon
After=graphical-session.target pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/Documents/redphone/daemon.py
Restart=always
RestartSec=2
KillMode=process
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1

[Install]
WantedBy=default.target
